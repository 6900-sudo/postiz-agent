{
  "tasks": {
    "lint": "deno lint",
    "test": "deno test -A"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-slow-types"]
    },
    "include": ["src/", "server/"],
    "exclude": ["node_modules/", "dist/"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "node-fetch": "npm:node-fetch@^3.3.2"
  },
  "compilerOptions": {
    "lib": ["ES2020"],
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "nodeModulesDir": true
}
